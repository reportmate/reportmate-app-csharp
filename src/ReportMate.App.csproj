<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ReportMate.App</RootNamespace>
    <!--
      Named for what it is now. "Managed Reports Runner" described a local runner
      console, which this stopped being when it became the fleet dashboard, and the
      runner it was named after is a different executable in another repository.
    -->
    <AssemblyName>ReportMate</AssemblyName>
    <AssemblyTitle>ReportMate</AssemblyTitle>
    <Product>ReportMate</Product>
    <Description>Native Windows dashboard for ReportMate - fleet views and the report for this device</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\ReportMate.ico')">Assets\ReportMate.ico</ApplicationIcon>
    <StartupObject>ReportMate.App.Program</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishTrimmed>false</PublishTrimmed>
    <NoWarn>$(NoWarn);MVVMTK0045;NU1900;CS0618</NoWarn>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">$([System.DateTime]::Now.ToString("yyyy.MM.dd.HHmm"))</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Self-contained single-file output only when a runtime is chosen (publish -r win-x64
       or win-arm64); a plain build stays framework-dependent so it compiles on any host. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$(VersionPrefix)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The payload models are the client's own: the GUI reads the JSON the runner
       writes to the cache, so it deserialises with the very classes that wrote it. -->
  <ItemGroup>
    <!--
      The module data shapes are owned by the runner and read here, so they are
      taken from the client repository as a pinned submodule rather than copied.
      A copy would drift, and this app exists to render exactly what the runner
      writes.
    -->
    <Compile Include="..\client\src\Models\Modules\*.cs" Link="Models\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Assets\ReportMate.ico')">
    <Resource Include="Assets\ReportMate.ico" />
  </ItemGroup>
  <ItemGroup Condition="Exists('Assets\ReportMate.png')">
    <Resource Include="Assets\ReportMate.png" />
  </ItemGroup>

</Project>
