<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The dashboard itself: every page, view model and service. The ReportMate app in
    app/ is a window around DashboardView, and another WPF app can host the same
    view to embed the dashboard (see "Embedding the dashboard" in the README).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ReportMate.App</RootNamespace>
    <AssemblyName>ReportMate.UI</AssemblyName>
    <AssemblyTitle>ReportMate UI</AssemblyTitle>
    <Product>ReportMate</Product>
    <Description>The ReportMate dashboard's pages and services, hostable in any WPF window</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);MVVMTK0045;NU1900;CS0618</NoWarn>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">$([System.DateTime]::Now.ToString("yyyy.MM.dd.HHmm"))</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$(VersionPrefix)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The payload models are the client's own: the GUI reads the JSON the runner
       writes to the cache, so it deserialises with the very classes that wrote it. -->
  <ItemGroup>
    <!--
      The module data shapes are owned by the runner and read here, so they are
      taken from the client repository as a pinned submodule rather than copied.
      A copy would drift, and this app exists to render exactly what the runner
      writes.
    -->
    <Compile Include="..\client\src\Models\Modules\*.cs" Link="Models\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Assets\ReportMate.png')">
    <Resource Include="Assets\ReportMate.png" />
  </ItemGroup>

</Project>
