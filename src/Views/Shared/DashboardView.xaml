<UserControl x:Class="ReportMate.App.Views.Shared.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- The whole dashboard: header and pages. The ReportMate app's window draws it
         into its own title bar; another WPF app can host it anywhere. -->
    <Grid Background="{DynamicResource AppBackgroundBrush}"
          TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Chrome, in the web header's order: platform toggle, search, tabs, settings. -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The mark is the bare logo, as the web header has it: the amber
                     rounded square belongs to the app icon, not to a 20px mark
                     sitting on the header's own background. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="2,0,10,0">
                    <Image Source="pack://application:,,,/ReportMate.UI;component/Assets/ReportMate.png"
                           Width="20" Height="20" Margin="0,0,8,0" />
                    <TextBlock Text="ReportMate" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Platform scope. Choosing the platform already showing goes back
                     to the whole fleet, as the web's toggle does. -->
                <Border Grid.Column="1" CornerRadius="7" Padding="2" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="PlatformMac" ToolTip="Show only Macs"
                                      Style="{StaticResource PlatformToggleStyle}"
                                      Click="OnPlatformToggled" Tag="Mac">
                            <ui:FontIcon Glyph="&#xE770;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="PlatformWindows" ToolTip="Show only Windows devices"
                                      Style="{StaticResource PlatformToggleStyle}"
                                      Click="OnPlatformToggled" Tag="Windows">
                            <ui:FontIcon Glyph="&#xE977;" FontSize="14" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- Search, centred in the space the toggle and tabs leave. -->
                <Grid Grid.Column="2" MaxWidth="420" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Margin="12,0"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:AutoSuggestBox x:Name="SearchBox"
                                       PlaceholderText="Search by name, serial, asset or hostname"
                                       QuerySubmitted="OnSearchSubmitted"
                                       TextChanged="OnSearchTextChanged"
                                       SuggestionChosen="OnSearchSuggestionChosen"
                                       ItemTemplate="{StaticResource DeviceSuggestionTemplate}" />
                </Grid>

                <Border Grid.Column="3" CornerRadius="9" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" Padding="2">
                    <StackPanel Orientation="Horizontal" x:Name="TabBar" />
                </Border>

                <!-- The right margin clears the window's caption buttons when the
                     header sits in a title bar; see CaptionButtonsWidth. -->
                <StackPanel x:Name="TrailingItems" Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                    <RadioButton x:Name="TabSettings" ToolTip="Settings"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                 Tag="Settings" GroupName="MainTabs" Checked="OnTabChecked"
                                 Style="{StaticResource NavigationTabStyle}">
                        <ui:FontIcon Glyph="&#xE713;" FontSize="14" />
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" />
    </Grid>
</UserControl>
