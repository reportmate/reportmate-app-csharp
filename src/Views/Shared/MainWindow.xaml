<Window x:Class="ReportMate.App.Views.Shared.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        Title="ReportMate"
        Height="960" Width="1440" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Chrome, in the web header's order: platform toggle, search, tabs, settings. -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Platform scope. Choosing the platform already showing goes back
                     to the whole fleet, as the web's toggle does. -->
                <Border Grid.Column="0" CornerRadius="7" Padding="2" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="PlatformMac" ToolTip="Show only Macs"
                                      Style="{StaticResource PlatformToggleStyle}"
                                      Click="OnPlatformToggled" Tag="Mac">
                            <ui:FontIcon Glyph="&#xE770;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="PlatformWindows" ToolTip="Show only Windows devices"
                                      Style="{StaticResource PlatformToggleStyle}"
                                      Click="OnPlatformToggled" Tag="Windows">
                            <ui:FontIcon Glyph="&#xE977;" FontSize="14" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- Search, centred in the space the toggle and tabs leave. -->
                <Grid Grid.Column="1" MaxWidth="420" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Margin="12,0"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:AutoSuggestBox x:Name="SearchBox"
                                       PlaceholderText="Search by name, serial, asset or hostname"
                                       QuerySubmitted="OnSearchSubmitted"
                                       TextChanged="OnSearchTextChanged"
                                       SuggestionChosen="OnSearchSuggestionChosen"
                                       ItemTemplate="{StaticResource DeviceSuggestionTemplate}" />
                </Grid>

                <Border Grid.Column="2" CornerRadius="9" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" Padding="2">
                    <StackPanel Orientation="Horizontal" x:Name="TabBar" />
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,140,0">
                    <RadioButton x:Name="TabSettings" ToolTip="Settings"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                 Tag="Settings" GroupName="MainTabs" Checked="OnTabChecked"
                                 Style="{StaticResource NavigationTabStyle}">
                        <ui:FontIcon Glyph="&#xE713;" FontSize="14" />
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>
