<Page x:Class="ReportMate.App.Views.Shared.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Foreground="{DynamicResource TextPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabelStyle}">
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="SectionBody" TargetType="StackPanel">
            <Setter Property="MaxWidth" Value="620" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="4,8,4,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" Margin="28,24,28,32" HorizontalAlignment="Center">

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="This machine's connection to the fleet, and the fleet's own settings."
                           Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="{Binding IsSaveStatusVisible, Converter={StaticResource BoolToVisibility}}">
                    <ui:FontIcon Glyph="{Binding SaveStatusGlyph}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SaveStatusMessage}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!--
                One tab per section, matching the web app's settings menu and the Mac
                client's. What used to be here was the collection agent's own
                configuration (osquery path, collection interval, Cimian
                integration, retry count, proxy, cache directory) which this app
                inherited from the runner it was forked from and which a dashboard
                cannot act on. The only machine-local settings a dashboard needs are
                the ones that let it read the fleet at all.
            -->
            <!-- The device page's tab strip, reused so the two look like one app. -->
            <StackPanel x:Name="SectionTabs" Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton Content="General" Tag="General" GroupName="SettingsSections"
                             Style="{StaticResource DeviceTabStyle}" Checked="OnSectionChecked" IsChecked="True" />
                <RadioButton Content="Inventory Mapping" Tag="Inventory" GroupName="SettingsSections"
                             Style="{StaticResource DeviceTabStyle}" Checked="OnSectionChecked" />
                <RadioButton Content="Security Rules" Tag="Security" GroupName="SettingsSections"
                             Style="{StaticResource DeviceTabStyle}" Checked="OnSectionChecked" />
                <RadioButton Content="Kiosk Displays" Tag="Kiosk" GroupName="SettingsSections"
                             Style="{StaticResource DeviceTabStyle}" Checked="OnSectionChecked" />
                <RadioButton Content="Maintenance" Tag="Maintenance" GroupName="SettingsSections"
                             Style="{StaticResource DeviceTabStyle}" Checked="OnSectionChecked" />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,4,0,0">
                <Grid>
                    <StackPanel x:Name="GeneralBody" Style="{StaticResource SectionBody}">
                    <StackPanel Style="{StaticResource SectionBody}">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ThemeBox" Width="240" HorizontalAlignment="Left"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="Follow system" Tag="Default" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>

                        <TextBlock Text="Connection" Style="{StaticResource SectionHeaderStyle}" Margin="0,22,0,0" />
                        <TextBlock Text="Where this machine reads the fleet from. Stored on this machine only."
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <TextBlock Text="API URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ui:ControlHelper.PlaceholderText="https://reportmate.example.org"
                                 IsEnabled="{Binding IsApiUrlLocked, Converter={StaticResource InvertBool}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding IsApiUrlLocked, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Managed by Policy" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <!--
                            The passphrase, not the API key. The runner's key is an
                            ingest credential: it can report this device's data in but
                            is refused for every read, so a dashboard configured with
                            it shows nothing on every page.
                        -->
                        <TextBlock Text="Read passphrase" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PassphraseBox" PasswordChanged="OnPassphraseChanged"
                                     ui:ControlHelper.PlaceholderText="{Binding PassphrasePlaceholderText}"
                                     IsEnabled="{Binding IsPassphraseLocked, Converter={StaticResource InvertBool}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding IsPassphraseLocked, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Managed by Policy" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" Margin="0,22,0,0" />
                        <TextBlock Text="{Binding VersionDisplay}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:HyperlinkButton Content="Documentation" NavigateUri="https://github.com/reportmate/reportmate-app-csharp" />
                            <ui:HyperlinkButton Content="Report Issue" NavigateUri="https://github.com/reportmate/reportmate-app-csharp/issues" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="InventoryBody" Style="{StaticResource SectionBody}" Visibility="Collapsed" />
                    <StackPanel x:Name="SecurityBody" Style="{StaticResource SectionBody}" Visibility="Collapsed" />
                    <StackPanel x:Name="KioskBody" Style="{StaticResource SectionBody}" Visibility="Collapsed" />
                    <StackPanel x:Name="MaintenanceBody" Style="{StaticResource SectionBody}" Visibility="Collapsed" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
